{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#]+#/(?<depType>Config|Builtins)\\.pkl"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/{{{depType}}}.pkl"
    },
    {
      "description": "Homebrew/actions tags have four parts (2026.11.02.1), which the github-actions manager cannot read as a version and skips, so this manager reads the full tag.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: Homebrew/actions/[^@\\s]+@(?:(?<currentDigest>[0-9a-f]{40}) # )?(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "Homebrew/actions",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.swiftformat$/"],
      "matchStrings": ["--swiftversion (?<currentValue>\\S+)"],
      "depNameTemplate": "swift",
      "packageNameTemplate": "swiftlang/swift",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^swift-(?<version>.+)-RELEASE$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The Homebrew/actions custom manager above owns these pins; the built-in manager cannot read their tags.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["Homebrew/actions"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["Homebrew/actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jdx/hk"],
      "groupName": "hk",
      "groupSlug": "hk"
    },
    {
      "matchManagers": ["swift"],
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["FluidInference/FluidAudio"],
      "groupName": "FluidAudio",
      "groupSlug": "fluid-audio",
      "labels": ["dependencies", "fluid-audio"],
      "description": "Review FluidAudio dependency changes and rerun the MVP regression corpus before merging."
    }
  ]
}
