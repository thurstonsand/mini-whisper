    "width" : 1280,
    "x" : 0,
    "y" : 202.78571428571428
  },
  {
    "height" : 15.642857142857142,
    "role" : "AXTextArea",
    "text" : " or move the unreadable file aside first and start clean deliberately. Either is defensible; silently overwriting is not.",
