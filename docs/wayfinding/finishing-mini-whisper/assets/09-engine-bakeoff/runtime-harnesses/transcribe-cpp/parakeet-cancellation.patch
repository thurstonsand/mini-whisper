+void set_scheduler_abort_callback(ggml_backend_sched_t sched, ggml_abort_callback callback, void * user_data) {
+    const int n_backends = ggml_backend_sched_get_n_backends(sched);
+    for (int i = 0; i < n_backends; ++i) {
+        ggml_backend_t     backend = ggml_backend_sched_get_backend(sched, i);
+        ggml_backend_dev_t device  = ggml_backend_get_device(backend);
+        ggml_backend_reg_t reg     = ggml_backend_dev_backend_reg(device);
+        auto setter = reinterpret_cast<ggml_backend_set_abort_callback_t>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_abort_callback"));
+        if (setter != nullptr) {
+            setter(backend, callback, user_data);
+        }
+    }
+}
