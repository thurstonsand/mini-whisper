#!/bin/bash
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
output="${1:-$here/quick-add-disclosure.png}"
binary="$here/QuickAddDisclosureCapture"
log_file="$here/.capture.$$.log"

cleanup() {
  kill "${pid:-}" 2>/dev/null || true
  wait "${pid:-}" 2>/dev/null || true
  rm -f "$binary" "$log_file"
}
trap cleanup EXIT

swiftc -framework AppKit "$here/QuickAddDisclosure.swift" -o "$binary"
"$binary" >"$log_file" 2>&1 &
pid=$!
sleep 1

osascript - "$output" <<'APPLESCRIPT'
on run argv
  set outputPath to item 1 of argv
  tell application "System Events"
    tell process "QuickAddDisclosureCapture"
      if (count of menu bars) is 0 then error "Could not find the disclosure status item"
      set targetItem to menu bar item 1 of menu bar 1
      click targetItem
      delay 0.4
      set theMenu to menu 1 of targetItem
      set {x, y} to position of theMenu
      set {w, h} to size of theMenu
    end tell
    do shell script "screencapture -o -R " & x & "," & y & "," & w & "," & h & " " & quoted form of outputPath
    key code 53
  end tell
end run
APPLESCRIPT

echo "$output"
