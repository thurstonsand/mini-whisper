#!/bin/bash
set -euo pipefail

output="${1:-menu_screenshot.png}"

osascript -e '
tell application "System Events"
    tell process "MiniWhisper"
        click menu bar item "waveform" of menu bar 2
        delay 0.2
        set theMenu to menu 1 of menu bar item "waveform" of menu bar 2
        set {x, y} to position of theMenu
        set {w, h} to size of theMenu
        return "" & x & "," & y & "," & w & "," & h
    end tell
end tell
' | xargs -I {} screencapture -R {} "$output"

echo "Saved to $output"
