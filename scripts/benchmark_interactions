#!/usr/bin/env bash
set -euo pipefail

: "${APP_PATH:?APP_PATH must name the built MiniWhisper app}"

# Each channel's executable is named for its channel, so the benchmark measures whichever one
# APP_PATH points at and never mistakes a sibling for it.
app_name="$(basename "$APP_PATH" .app)"

if pgrep -x "$app_name" >/dev/null; then
  echo "$app_name is already running. Quit it before the live benchmark." >&2
  exit 1
fi

mkdir -p .build
performance_log=.build/miniwhisper-performance.log
app_log=.build/miniwhisper-performance-app.log
rm -f "$performance_log" "$app_log"

log stream --style compact --level info \
  --predicate 'subsystem == "com.thurstonsand.MiniWhisper"' >"$performance_log" 2>&1 &
log_pid=$!
cleanup() {
  kill "$log_pid" 2>/dev/null || true
}
trap cleanup EXIT

MINIWHISPER_BENCHMARK_ACTIVATION=1 \
  "$APP_PATH/Contents/MacOS/$app_name" >"$app_log" 2>&1
sleep 1
cleanup
trap - EXIT

python3 scripts/report_interaction_latencies.py "$performance_log"
