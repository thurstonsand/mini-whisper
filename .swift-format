{
  "version": 1,
  "lineLength": 100,
  "indentation": {
    "spaces": 2
  },
  "tabWidth": 2,
  "maximumBlankLines": 1,
  "spacesBeforeEndOfLineComments": 2,
  "respectsExistingLineBreaks": false,
  "prioritizeKeepingFunctionOutputTogether": true,
  "reflowMultilineStringLiterals": "onlyLinesOverLength",
  "orderedImports": {
    "includeConditionalImports": true
  }
}
